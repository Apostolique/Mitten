<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>GameProject</RootNamespace>
    <AssemblyName>Mitten</AssemblyName>
    <DefineConstants>$(DefineConstants);KNI;BLAZORGL</DefineConstants>
    <KniPlatform>BlazorGL</KniPlatform>
  </PropertyGroup>

  <PropertyGroup>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <!-- The only culture the game names is `CultureInfo.InvariantCulture`, so the three
         icu*.dat files can go. itch.io serves `.dat` with no compression at all. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Nothing reads the `.br` and `.gz` copies now that index.html doesn't, and they were
         doubling the size of the push to itch. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.17" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.17" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="nkast.Xna.Framework" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Audio" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Media" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Devices" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Storage" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.XR" Version="4.2.9001" />
    <PackageReference Include="nkast.Kni.Platform.Blazor.GL" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content.Pipeline.Builder" Version="4.2.9001" />

    <PackageReference Include="Apos.Input.KNI" Version="3.0.0" />
    <PackageReference Include="Apos.Shapes.KNI" Version="0.8.1" />
    <PackageReference Include="Apos.Tweens.KNI" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Pages/Index.razor.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <!-- `SDL2.cs` is the SDL2 bindings the tablet code reaches the window handle through. The
       tablet paths themselves are behind `SDLWINDOWS`/`SDLLINUX` and compile to nothing here,
       while the bindings are plain `DllImport`s that would build against a library the browser
       has no way to load. -->
  <ItemGroup>
    <Compile Include="../../Game/**/*.cs" Exclude="../../Game/SDL2.cs">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <!-- Nothing here needs building: Apos.Shapes reads the font's outlines itself, so the file is
       served as-is. Linking it under `wwwroot` makes it a static web asset, which is what puts
       it where `TitleContainer` looks for it.

       Publish only. The asset's content root comes out as this project's `wwwroot`, which the
       file never gets copied into, so `dotnet run` serves a 404 and the game dies in
       `LoadContent`. Test the browser build against `dotnet publish` output. -->
  <ItemGroup>
    <Content Include="../../Content/**/*.ttf" Exclude="../../Content/bin/**;../../Content/obj/**">
      <Link>wwwroot/Content/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
